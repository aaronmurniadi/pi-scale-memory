{
	"name": "pi-scale-memory",
	"version": "0.1.0",
	"description": "Pi agent extension: one shared memory for many pi agents over Tailscale, with offline mirroring",
	"type": "module",
	"main": "index.ts",
	"keywords": [
		"pi",
		"pi-package",
		"memory",
		"tailscale"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"src",
		"brain",
		"README.md"
	],
	"bin": {
		"pi-scale-brain": "brain/server.mjs"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit",
		"brain": "node brain/server.mjs",
		"test": "tsx test/unit.ts"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.84.1",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/node": "^22.0.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	}
}
